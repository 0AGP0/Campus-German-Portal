# --- Veritabanı (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:SIFRE@127.0.0.1:5432/campus_german_portal?schema=public"

# --- Next.js + NextAuth (Apply2Campus benzeri tek süreç: node server.mjs) ---
PORT=3000
# NextAuth imzası — JWT_SECRET ile aynı olabilir
NEXTAUTH_SECRET=""
# Tarayıcıda hangi adresi kullanıyorsanız aynı olmalı (localhost ≠ 127.0.0.1)
NEXTAUTH_URL="http://127.0.0.1:3000"
JWT_SECRET=""
SESSION_MAX_AGE=604800
COOKIE_SECURE=0

WEBHOOK_SECRET=""

# İlk admin (npm run db:seed)
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""

# İsteğe bağlı e-posta
# SMTP_HOST=
# SMTP_PORT=587
# NOTIFY_EMAIL=

# İsteğe bağlı: booking resmi PDF Vorlage (mutlak yol veya proje köküne göre)
# BOOKING_VORLAGE_PATH="D:/proje/Vorlage.pdf"
# Şablon üzerine metin çizmeyi kapat (yalnızca jsPDF): BOOKING_VORLAGE_DISABLE_OVERLAY=1

# Word şablonu (.docx) — {first_name} gibi yer tutucular; yoksa public/templates/booking-official-vorlage.docx veya kökte *vorlage*.docx aranır
# BOOKING_VORLAGE_DOCX_PATH="D:/proje/Vorlage.docx"

# Alt dizin deploy
# NEXT_PUBLIC_BASE_PATH=/crm/
